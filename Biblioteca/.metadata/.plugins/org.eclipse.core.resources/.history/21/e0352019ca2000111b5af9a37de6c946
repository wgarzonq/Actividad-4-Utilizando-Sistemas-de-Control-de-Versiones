/*
* En esta clase se hacen las operaciones de agregar, traer, buscar, cargar los libros para la visualización
* en la interfaz gráfica. Tomando como base la clase Libro donde se estructura que información debe 
* contener cada objeto
*/
public class GestionLibros {

	// Se construye una lista vacia para iterar los objetos de la clase Libro
	private LinkedList<Libro> listaLibros = new LinkedList<Libro>();

	// Método para agregar un objeto Libro a la lista listaLibros
	public void agregar_libro(Libro libro) {
		listaLibros.add(libro);
	}

	// Método que devuelve el iterable de la lista LinkedList
	public ListIterator<Libro> traer_libros() {
		return listaLibros.listIterator();
	}

	// Método para devolver el iterable de la lista mediante una busqueda
	// por Título, Autor y Editorial
	public ListIterator<Libro> buscar_titulo(String busqueda) {

		// Condicional si el parametro busqueda está vacio
		if (busqueda == null || busqueda.trim().isEmpty()) {
			return listaLibros.listIterator();
		}

		LinkedList<Libro> resultados = new LinkedList<Libro>();

		ListIterator<Libro> iteradorLibros = listaLibros.listIterator();

		while (iteradorLibros.hasNext()) {

			Libro libroActual = iteradorLibros.next();

			if (libroActual.tituloLibro().toLowerCase().contains(busqueda.toLowerCase())
					|| libroActual.editorialLibro().toLowerCase().contains(busqueda.toLowerCase())
					|| libroActual.autorLibro().toLowerCase().contains(busqueda.toLowerCase())) {

				resultados.add(libroActual);
			}
		}

		return resultados.listIterator();
	}

