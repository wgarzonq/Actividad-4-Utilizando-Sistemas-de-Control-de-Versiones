	// Función para seleccionar la imagen del libro
	private void seleccionarImagen() {

		// Se instancia el objeto para abrir el explorador de archivos y cargar la imagen
		JFileChooser fileChooser = new JFileChooser();

		fileChooser.setDialogTitle("Seleccionar Imagen");

		// Definimos el estado del seleccionador de archivos
		int resultado = fileChooser.showOpenDialog(null);

		// Verificación del estado si se eligio un archivo
		if (resultado == JFileChooser.APPROVE_OPTION) {

			// Se guarda en un objeto tipo File la imagen elegida
			imagenSeleccionada = fileChooser.getSelectedFile();

			// Se configura la imagen seleccionada en el previsualizador
			icon = new ImageIcon(imagenSeleccionada.getAbsolutePath());

			img = icon.getImage().getScaledInstance(200, 200, Image.SCALE_SMOOTH);

			imagenPreview.setIcon(new ImageIcon(img));

		}

	}

	// Función para guardar la imagen dentro del proyecto JAVA
	private void guardarImagen() {

		// Verificación si la imagen seleccionada del explorador no es nula
		if (imagenSeleccionada != null) {

			// Excepción de la operación para la extracción de la imagen
			try {

				// Configurar el destino de traslado
				destino = Paths.get("src/img/img_temp/" + imagenSeleccionada.getName());

				// Sacar la copia al destino de traslado
				Files.copy(imagenSeleccionada.toPath(), destino, StandardCopyOption.REPLACE_EXISTING);

			} catch (IOException e) {

				// Imprime en consola la excepción
				e.printStackTrace();

			}

		}

	}

	
	// Función para Agregar el nuevo objeto Libro
	private class Accion_Agregar implements ActionListener {

		@Override
		public void actionPerformed(ActionEvent e) {

			// Variable booleana para validar que el formulario no este vacio
			boolean vacio = (tituloCampo.getText().trim().isEmpty() && editorialCampo.getText().trim().isEmpty()
					&& autorCampo.getText().trim().isEmpty() && nPaginasCampo.getText().trim().isEmpty()
					&& idiomaCampo.getText().trim().isEmpty() && imagenSeleccionada == null);

			// Verificar por medio de la variable creada que los campos esten completados
			if (!vacio) {
				
				// Se llama la instancia global de GestionLibros
				GestionLibros gestorLibros = LlamarGlobales.getInstancia().getGestionLibros();

				// Traer el iterador de los libros almacenados
				ListIterator<Libro> libros = gestorLibros.traer_libros();

				// Objeto Libro para almacenar el ultimo registro en el iterador
				Libro ultimoLibro = null;

				// Se verifica si el iterador tiene elementos
				while (libros.hasNext()) {

					// Se almacena el ultimo objeto iterado
					ultimoLibro = libros.next();

				}

				// Variable para almacenar el id que va a tener el nuevo registro
				int nuevoId = 0;

				if (ultimoLibro != null) {

					nuevoId = ultimoLibro.idLibro() + 1;

				}

				guardarImagen();

				Libro libro = new Libro(nuevoId, tituloCampo.getText(), editorialCampo.getText(), autorCampo.getText(),
						nPaginasCampo.getText(), idiomaCampo.getText(), destino.toString());

				gestorLibros.agregar_libro(libro);

				Panel marcoPanel = new Panel(usuarios);

				marcoPanel.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

				marcoPanel.setResizable(false);

				marcoPanel.setVisible(true);

				vAhora.setVisible(false);
			} else {

				JOptionPane.showMessageDialog(new JPanel(), "Por favor, llene todos los campos", "Campos Vacios", 2);

			}

		}

	}

