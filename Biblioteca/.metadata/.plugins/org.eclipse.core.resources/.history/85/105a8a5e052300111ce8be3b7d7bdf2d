// Lamina de la tabla libros
class TablaLibros extends JPanel {

	// Constructor de la clase pidiendo como parametros un objeto GestionUsuarios y
	// el Frame actual
	public TablaLibros(GestionUsuarios usuarios, Panel vAhora) {

		// Asigna los parametros a las variables de clase
		this.usuarios = usuarios;

		this.vAhora = vAhora;

		// Configuración de la lamina
		setLayout(new BorderLayout());

		// Lamina de panel superior
		JPanel panelSuperior = new JPanel(new BorderLayout());

		panelSuperior.setBackground(Color.DARK_GRAY);

		// Titulo de la lamina
		JLabel subTitulo = new JLabel("Libros");

		subTitulo.setFont(new Font("Calibri", Font.BOLD, 28));

		subTitulo.setBorder(BorderFactory.createEmptyBorder(10, 10, 0, 10));

		subTitulo.setForeground(Color.WHITE);

		// Botón para añadir un nuevo libro
		JButton anadirBoton = new JButton("Añadir Libro");

		anadirBoton.setForeground(Color.white);

		anadirBoton.setBackground(Color.gray);

		anadirBoton.setFont(new Font("Calibri", Font.PLAIN, 16));

		anadirBoton.setPreferredSize(new Dimension(160, 40));

		anadirBoton.setBorder(BorderFactory.createEmptyBorder(5, 10, 0, 10));

		anadirBoton.setFocusPainted(false);

		// Evento para direccionar a la ventana de agregar
		anadirBoton.addActionListener(e -> {

			// Direccionar a la ventana de agregar libro
			Agregar vAgregar = new Agregar(usuarios);

			vAgregar.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

			vAgregar.setResizable(false);

			vAgregar.setVisible(true);

			vAhora.setVisible(false);

		});

		// Añade el título y el botón de agregar a la lamina del panel superior
		panelSuperior.add(subTitulo, BorderLayout.WEST);

		panelSuperior.add(anadirBoton, BorderLayout.EAST);

		panelSuperior.setBorder(BorderFactory.createEmptyBorder(10, 20, 10, 10));

		// Agrega el panel superior a la lamina principal
		add(panelSuperior, BorderLayout.NORTH);

		// Define las columnas de la tabla
		String[] columnas = { "Imagen", "Título", "Editorial", "Autor", "No.Páginas", "Idioma" };

		// Establece el modelo de la tabla
		modelo = new DefaultTableModel(columnas, 0) {

			// Si la celda es editable
			@Override
			public boolean isCellEditable(int row, int column) {
				return false;
			}

			// Configuración de las columnas
			@Override
			public Class<?> getColumnClass(int column) {

				// Si la columna es la posición O
				if (column == 0) {

					// Retorna un objeto icono
					return ImageIcon.class;
				}

				// Retorna a las demas un objeto Object
				return Object.class;
			}
		};

		// Instancia la tabla
		tabla = new JTable(modelo);

		tabla.getColumnModel().getColumn(0).setPreferredWidth(200);

		tabla.setAutoResizeMode(JTable.AUTO_RESIZE_OFF);

		// Centra el contenido de la tabla
		DefaultTableCellRenderer centrado = new DefaultTableCellRenderer();

		centrado.setHorizontalAlignment(JLabel.CENTER);

		// Se confirma las configuraciones como debe ir cada columna de la tabla
		for (int i = 1; i < tabla.getColumnCount(); i++) {

			tabla.getColumnModel().getColumn(i).setPreferredWidth(200);

			tabla.getColumnModel().getColumn(i).setCellRenderer(centrado);

		}

		// Configura el header de la tabla
		DefaultTableCellRenderer headerRenderer = (DefaultTableCellRenderer) tabla.getTableHeader()
				.getDefaultRenderer();

		headerRenderer.setHorizontalAlignment(JLabel.CENTER);

		// Configura la tabla
		tabla.setRowHeight(150);

		tabla.setGridColor(Color.BLACK);

		tabla.setBackground(Color.WHITE);

		tabla.setForeground(Color.BLACK);

		tabla.setFont(new Font("Calibri", Font.BOLD, 14));

		// la configuración del header se pasa al objeto JTableHeader
		JTableHeader header = tabla.getTableHeader();

		// Configuración del objeto JTableHeader
		header.setBackground(Color.GRAY);

		header.setForeground(Color.WHITE);

		header.setFont(new Font("Calibri", Font.BOLD, 16));

		// Scroll configurado para la tabla establecida
		JScrollPane scroll = new JScrollPane(tabla);

		scroll.setPreferredSize(new Dimension(900, 400));

		scroll.setHorizontalScrollBarPolicy(JScrollPane.HORIZONTAL_SCROLLBAR_ALWAYS);

		scroll.setVerticalScrollBarPolicy(JScrollPane.VERTICAL_SCROLLBAR_ALWAYS);

		// Se añade la tabla a la lamina
		add(scroll, BorderLayout.CENTER);

		// Llama los datos a imprimir
		cargarDatos();

	}

	// Función para cargar los datos a imprimir en la tabla
	private void cargarDatos() {

		// Refresca la tabla
		modelo.setRowCount(0);

		// De la clase global LlamarGlobales se enfoca al objeto GestionLibros
		GestionLibros libros = LlamarGlobales.getInstancia().getGestionLibros();

		// Asigna al iterador, el iterador que contiene los libros almacenados en el
		// aplicativo
		ListIterator<Libro> iterador = libros.traer_libros();

		// Revisa si el iterador contiene elementos
		while (iterador.hasNext()) {

			// Asigna el elemento iterado a un objeto Libro
			Libro libro = iterador.next();

			// Define el icono para la imagen
			ImageIcon icono = null;

			// Excepción de la lectura de la imagen
			try {

				// Lee la imagen de la propiedad del objeto Libro
				Image img = ImageIO.read(new File(libro.imagenLibro()));

				// Configura el path leido para asignarlo al icono
				Image scaled = img.getScaledInstance(50, 100, Image.SCALE_SMOOTH);

				icono = new ImageIcon(scaled);

			} catch (IOException e) {

				// El icono queda nulo si no se lee la imagen
				icono = null;

			}

			// Establece mediante el objeto Libro de la iteración y el icono configurado el
			// contenido
			// impreso en la tabla
			Object[] fila = { icono, libro.tituloLibro(), libro.editorialLibro(), libro.autorLibro(),
					libro.nPaginasLibro(), libro.idiomaLibro() };

			// Se añade el array de la información de la tabla a la tabla valga la
			// redundancia
			modelo.addRow(fila);

		}

	}

	// Propiedades de la clase
	private JTable tabla;

	private DefaultTableModel modelo;

	private GestionUsuarios usuarios;

	private Panel vAhora;

}

// Lamina de la tabla de solicitudes
class TablaSolicitudes extends JPanel {

	// Constructor de la clase pidiendo como requerimientos un objeto
	// GestionUsuarios y el frame actual
	public TablaSolicitudes(GestionUsuarios usuarios, Panel vAhora) {

		// Los parametros recibidos se asignan a variables de clase
		this.usuarios = usuarios;

		this.vAhora = vAhora;

		// Configuración de la lamina
		setLayout(new BorderLayout());

		// Instancia y configuración de la lamina panelSuperior
		JPanel panelSuperior = new JPanel(new FlowLayout(FlowLayout.LEFT, 20, 25));

		panelSuperior.setBackground(Color.DARK_GRAY);

		// Título de la tabla
		JLabel subTitulo = new JLabel("Solicitudes");

		subTitulo.setFont(new Font("Calibri", Font.BOLD, 28));

		subTitulo.setBorder(BorderFactory.createEmptyBorder(10, 10, 0, 10));

		subTitulo.setForeground(Color.WHITE);

		panelSuperior.add(subTitulo);

		// Añade la lamina superior a la lamina principal
		add(panelSuperior, BorderLayout.NORTH);

		// Define las columnas
		String[] columnas = { "Imagen", "Título", "Editorial", "Autor", "Nombre Solicitante", "Documento Solicitante",
				"", "" };

		// Establece el modelo de la tabla
		modelo = new DefaultTableModel(columnas, 0) {

			// Si es editable
			@Override
			public boolean isCellEditable(int row, int column) {

				// En este caso se edita la columna 6 y 7 donde se ubican los botones de acción
				return column == 6 || column == 7;
			}

			// Objetos de las columnas
			@Override
			public Class<?> getColumnClass(int column) {

				// La columna 0 devuelve un objeto tipo ImageIcon
				if (column == 0) {
					return ImageIcon.class;
				}

				// La demas columnas se devuelven de tipo Object
				return Object.class;
			}
		};

		// Instancia de la tabla recibiendo el modelo configurado
		tabla = new JTable(modelo);

		tabla.setAutoResizeMode(JTable.AUTO_RESIZE_OFF);

		// Configuración para centrar el contenido de la tabla
		DefaultTableCellRenderer centrado = new DefaultTableCellRenderer();

		centrado.setHorizontalAlignment(JLabel.CENTER);

		// Establece las configuraciones de diseño de la tabla
		for (int i = 1; i < tabla.getColumnCount(); i++) {

			tabla.getColumnModel().getColumn(i).setPreferredWidth(200);

			tabla.getColumnModel().getColumn(i).setCellRenderer(centrado);

		}

		// Configuración del header de la tabla
		DefaultTableCellRenderer headerRenderer = (DefaultTableCellRenderer) tabla.getTableHeader()
				.getDefaultRenderer();

		headerRenderer.setHorizontalAlignment(JLabel.CENTER);

		// En las columnas de la imagen y los botones de acción se llaman propiedades
		// que actuan unicamente en ellas
		// en el caso de los botones se asocian a clases para poder ejecutar los eventos
		// y renderizar en la tabla
		// ya que no se hace directamente en un objeto JPanel
		tabla.getColumnModel().getColumn(0).setPreferredWidth(200);

		tabla.getColumnModel().getColumn(6).setCellRenderer(new ButtonRenderer());

		tabla.getColumnModel().getColumn(6).setCellEditor(new ButtonEditor());

		tabla.getColumnModel().getColumn(7).setCellRenderer(new ButtonRenderer());

		tabla.getColumnModel().getColumn(7).setCellEditor(new ButtonEditor());

		tabla.setRowHeight(150);

		tabla.setGridColor(Color.BLACK);

		tabla.setBackground(Color.WHITE);

		tabla.setForeground(Color.BLACK);

		tabla.setFont(new Font("Calibri", Font.BOLD, 14));

		// Instancia de JTableHeader recibiendo la configuración del header
		JTableHeader header = tabla.getTableHeader();

		header.setBackground(Color.GRAY);

		header.setForeground(Color.WHITE);

		header.setFont(new Font("Calibri", Font.BOLD, 16));

		// Scroll de la tabla
		JScrollPane scroll = new JScrollPane(tabla);

		scroll.setPreferredSize(new Dimension(900, 400));

		scroll.setHorizontalScrollBarPolicy(JScrollPane.HORIZONTAL_SCROLLBAR_ALWAYS);

		scroll.setVerticalScrollBarPolicy(JScrollPane.VERTICAL_SCROLLBAR_ALWAYS);

		// Añade la tabla a la lamina
		add(scroll, BorderLayout.CENTER);

		// Carga de datos para imprimir en la tabla
		cargarDatos();

	}

	// Función para cargar los datos para imprimir en la tabla
	private void cargarDatos() {

		// Refresca la tabla
		modelo.setRowCount(0);

		// Llamada al objeto LlamarGlobales enfocado al objeto GestionMovimientos
		GestionMovimientos solicitudes = LlamarGlobales.getInstancia().getGestionMovimientos();

		// Iterador que almacena el iterador de las solicitudes del objeto global
		Iterator<Movimiento> iterador = solicitudes.traer_solicitudes();

		// Variable para saber el primer valor de la cola en el iterador
		boolean esPrimero = true;

		// Si el iterador contiene elementos
		while (iterador.hasNext()) {

			// Objeto Movimiento que recibe el elemento iterado
			Movimiento solicitud = iterador.next();

			// Objeto ImageIcon para almacenar la imagen del libro solicitado
			ImageIcon icono = null;

			// Excepción de lectura del path de la imagen del libro solicitado
			try {

				// Lectura del path de la imagen del libro solicitado
				Image img = ImageIO.read(new File(solicitud.libroMovimiento.imagenLibro()));

				// Configuración de la imagen leida para presentarla en la tabla
				Image scaled = img.getScaledInstance(50, 100, Image.SCALE_SMOOTH);

				icono = new ImageIcon(scaled);

			} catch (IOException e) {

				// Se asigna al objeto ImageIcon el valor nulo si falla la lectura de la
				// propiedad
				// de la imagen del libro del objeto Movimiento
				icono = null;

			}

			// Objetos que representan los botones de acción
			// porque solo el primer elemento iterado contendra estos botones, los demas no
			Object aceptar = null;

			Object rechazar = null;

			// Si el elemento iterado es el primer registro de la cola
			if (esPrimero) {

				// Configuración del botón de aceptar
				aceptar = botonTabla("Aceptar", e -> {

					// Método de aceptar_solicitud de GestionMovimientos global
					solicitudes.aceptar_solicitud(new JPanel());

					// Direccionar a la ventana actual para ver reflejados los resultados
					Panel marcoPanel = new Panel(usuarios);

					marcoPanel.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

					marcoPanel.setResizable(false);

					marcoPanel.setVisible(true);

					vAhora.setVisible(false);

				});

				// Configuración del botón de rechazar
				rechazar = botonTabla("Rechazar", e -> {

					// Método de cancelar_solicitud de GestionMovimientos global
					solicitudes.cancelar_solicitud(new JPanel());

					// Direccionar a la ventana actual para ver reflejados los resultados
					Panel marcoPanel = new Panel(usuarios);

					marcoPanel.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

					marcoPanel.setResizable(false);

					marcoPanel.setVisible(true);

					vAhora.setVisible(false);

				});

				// Si ya se asignaron los botones al primer registro, la variable booleana es
				// falsa
				// para los demas
				esPrimero = false;

			}

			// Tanto el icono, los botones de acción y las propiedades del objeto movimiento
			// se establecen en un array Object
			Object[] fila = { icono, solicitud.libroMovimiento.tituloLibro(),
					solicitud.libroMovimiento.editorialLibro(), solicitud.libroMovimiento.autorLibro(),
					solicitud.usuarioMovimiento.nombreUsuario(), solicitud.usuarioMovimiento.tDocumentoUsuario() + ": "
							+ solicitud.usuarioMovimiento.nDocumentoUsuario(),
					aceptar, rechazar };

			// se añaden las filas de registros a la tabla
			modelo.addRow(fila);

		}

	}

	// función gráfica para los botones recibiendo su título y el evento
	private JButton botonTabla(String titulo, ActionListener evento) {

		// Instancia y configuración del botón
		JButton boton = new JButton(titulo);

		boton.setForeground(Color.white);

		boton.setBackground(Color.gray);

		boton.setFont(new Font("Calibri", Font.PLAIN, 16));

		boton.setPreferredSize(new Dimension(160, 40));

		boton.setFocusPainted(false);

		// Asocia el evento recibido al botón
		boton.addActionListener(evento);

		// Devuelve el objeto JButton
		return boton;
	}

