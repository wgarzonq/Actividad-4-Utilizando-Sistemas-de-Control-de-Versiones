		// Verifica si el usuario es administrador
		if (usuario.rolUsuario().equalsIgnoreCase("2"))
			contenedor.add(cajaLibros);

		// Verifica si el usuario es administrador
		if (usuario.rolUsuario().equalsIgnoreCase("2"))
			contenedor.add(Box.createVerticalStrut(20));

		// Verifica si el usuario es administrador
