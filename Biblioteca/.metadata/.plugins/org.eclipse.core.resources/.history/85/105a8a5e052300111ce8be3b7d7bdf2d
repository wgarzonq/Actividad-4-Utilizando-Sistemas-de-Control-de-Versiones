		// Contenidos por defecto
		contenedor.add(cajaPrestamos);

		contenedor.add(Box.createVerticalStrut(20));

		contenedor.add(cajaDevoluciones);

		contenedor.add(Box.createVerticalStrut(20));

		// Añadir el contenedor a la lamina
		add(contenedor);
	}
