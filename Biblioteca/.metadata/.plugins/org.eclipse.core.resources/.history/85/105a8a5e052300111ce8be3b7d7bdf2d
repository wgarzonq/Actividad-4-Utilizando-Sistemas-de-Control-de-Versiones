			// Excepción de la lectura de la imagen
			try {

				// Lectura del path de la imagen del libro devuelto
				Image img = ImageIO.read(new File(devolucion.libroMovimiento.imagenLibro()));

				// Configuración de la imagen leida para mostrarla en la tabla
				Image scaled = img.getScaledInstance(50, 100, Image.SCALE_SMOOTH);

				icono = new ImageIcon(scaled);

			} catch (IOException e) {

				// Si la lectura del path de la imagen falla
				icono = null;

			}

			// Establecemos mediante un array: la imagen del texto devuelto y el elemento iterado tipo Movimiento con la información de la devolución
			Object[] fila = { icono, devolucion.libroMovimiento.tituloLibro(),
					devolucion.libroMovimiento.editorialLibro(), devolucion.libroMovimiento.autorLibro(),
					devolucion.usuarioMovimiento.nombreUsuario(), devolucion.usuarioMovimiento.tDocumentoUsuario()
							+ ": " + devolucion.usuarioMovimiento.nDocumentoUsuario() };

			// Se añade el array con la información de la devolución iterada a la tabla
			modelo.addRow(fila);

		}

	}

