		// Refresca la tabla
		modelo.setRowCount(0);

		// Llamada a la clase global LlamarGlobales enfocada al objeto GestionMovimientos
		GestionMovimientos devoluciones = LlamarGlobales.getInstancia().getGestionMovimientos();

		// Iterador para recibir el iterador con las devoluciones
		ListIterator<Movimiento> iterador = devoluciones.traer_devoluciones();

		// Si el iterador tiene elementos
		while (iterador.hasNext()) {

			// Objeto Movimiento que recibe el elemento iterado
			Movimiento devolucion = iterador.next();

			// Objeto ImageIcon para recibir la imagen del libro devuelto
			ImageIcon icono = null;

			// Verificación si el elemento iterado no pertenece al usuario logueado y si el usuario logueado no es administrador
