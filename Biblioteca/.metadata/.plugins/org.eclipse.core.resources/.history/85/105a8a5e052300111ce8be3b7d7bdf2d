class ButtonRenderer extends JButton implements TableCellRenderer {
	public ButtonRenderer() {
		setOpaque(true);
		setFocusPainted(false);
	}

	@Override
	public Component getTableCellRendererComponent(JTable table, Object value, boolean isSelected, boolean hasFocus,
			int row, int column) {

		if (value instanceof JButton) {
			JButton boton = (JButton) value;

			setText(boton.getText());

			setBackground(boton.getBackground());

			setForeground(boton.getForeground());

			setFont(boton.getFont());

		} else {
			setText((value == null) ? "" : value.toString());
		}

		return this;

	}
}

class ButtonEditor extends DefaultCellEditor {

	private JButton boton;

	public ButtonEditor() {

		super(new JTextField());

		setClickCountToStart(1);

		boton = new JButton();

		boton.setFocusPainted(false);

		boton.setForeground(Color.white);

		boton.setBackground(Color.gray);

	}

	@Override
	public Component getTableCellEditorComponent(JTable table, Object value, boolean isSelected, int row, int column) {

		if (value instanceof JButton) {
			JButton original = (JButton) value;

			boton.setText(original.getText());

			for (ActionListener al : boton.getActionListeners()) {

				boton.removeActionListener(al);

			}

			for (ActionListener al : original.getActionListeners()) {

				boton.addActionListener(e -> {

					al.actionPerformed(e);

					fireEditingStopped();

				});

			}
		} else {

			boton.setText("");

			boton.setEnabled(false);
		}

		return boton;

	}

	@Override
	public Object getCellEditorValue() {

		return boton;

	}
}
