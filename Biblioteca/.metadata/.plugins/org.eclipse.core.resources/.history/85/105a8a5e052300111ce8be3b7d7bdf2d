		add(scroll, BorderLayout.CENTER);

		// Cargar los datos a imprimir en la tabla
		cargarDatos();

	}

	// Función para cargar los datos impresos en la tabla
	private void cargarDatos() {

		// Refrescar la tabla
		modelo.setRowCount(0);

		// Asignación de la Llamada al objeto LlamarGlobales enfocado al objeto GestionMovimientos
		GestionMovimientos prestamos = LlamarGlobales.getInstancia().getGestionMovimientos();

		// Iterador que recibe el iterador con los prestamos
		ListIterator<Movimiento> iterador = prestamos.traer_prestamos();

		// Objeto ImageIcon para la imagen del libro prestado
		ImageIcon icono = null;

		// Objeto boleano para saber si el usuario logueado es administrador
		boolean isAdmin = usuario.rolUsuario().equalsIgnoreCase("2");

		// Si el iterador contiene elementos
		while (iterador.hasNext()) {

			// Asigna a un objeto Movimiento el elemento iterado
			Movimiento prestamo = iterador.next();

			// Verificación si el elemento iterado no es del usuario logueado y si el usuario logueado
			// no es administrador
			if (!prestamo.usuarioMovimiento.idUsuario().equals(usuario.idUsuario()) && !isAdmin) {
				
				// Omite el elemento iterado si se cumple la condición
				continue;
			}

			
			// Excepción de la lectura de la imagen
			try {

				// Lectura del path de la imagen del libro prestado
				Image img = ImageIO.read(new File(prestamo.libroMovimiento.imagenLibro()));
				
				// Configuración de la imagen leida para visualizar en la tabla
				Image scaled = img.getScaledInstance(50, 100, Image.SCALE_SMOOTH);

				icono = new ImageIcon(scaled);

			} catch (IOException e) {

				// Si no se puede leer la imagen
				icono = null;

			}

			// Objeto que corresponde al botón de devolver el texto
			Object boton = null;

			// Si el usuario logueado es administrador
			if (isAdmin) {
				
				// Asigna al objeto Object un botón para realizar la acción de devolución
				boton = botonTabla("Devolver", e -> {

					// Método devolver_libro de la clase global pasandole el objeto Movimiento
					// relacionado con el prestamo iterado
					prestamos.devolver_libro(new JPanel(), prestamo);

					// Direccionar a la ventana actual para ver reflejados los resultados
					Panel marcoPanel = new Panel(usuarios);

					marcoPanel.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

					marcoPanel.setResizable(false);

					marcoPanel.setVisible(true);

					vAhora.setVisible(false);

				});
			}

			// Se establece en un array: la imagen del libro prestado, los elementos iterados de objeto Movimiento
			// relacionados al prestamo y el objeto Object del botón de devolución si el usuario logueado es administrador
			Object[] fila = { icono, prestamo.libroMovimiento.tituloLibro(), prestamo.libroMovimiento.editorialLibro(),
					prestamo.libroMovimiento.autorLibro(), prestamo.usuarioMovimiento.nombreUsuario(),
					prestamo.usuarioMovimiento.tDocumentoUsuario() + ": "
							+ prestamo.usuarioMovimiento.nDocumentoUsuario(),
					boton };

			// Añade el array de las filas a la tabla
			modelo.addRow(fila);
		}

	}

	// función gráfica para los botones recibiendo su título y el evento
	private JButton botonTabla(String titulo, ActionListener evento) {
		
		// Instancia y configuración del botón
		JButton boton = new JButton(titulo);

		boton.setForeground(Color.white);

		boton.setBackground(Color.gray);

		boton.setFont(new Font("Calibri", Font.PLAIN, 16));

		boton.setPreferredSize(new Dimension(160, 40));

		boton.setFocusPainted(false);

		// Asocia el evento recibido al botón
		boton.addActionListener(evento);

		// Devuelve el objeto JButton
		return boton;
	}

	// Propiedades de la clase
	private JTable tabla;

	private DefaultTableModel modelo;

	private Usuario usuario;

	private GestionUsuarios usuarios;

	private Panel vAhora;

}

