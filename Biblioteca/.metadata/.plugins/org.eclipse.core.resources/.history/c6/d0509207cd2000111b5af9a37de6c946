package biblioteca.com.funciones;

import java.util.*;

import javax.swing.JOptionPane;
import javax.swing.JPanel;

import biblioteca.com.clases.Libro;

import biblioteca.com.clases.Usuario;
import biblioteca.com.clases.Movimiento;

// Clase GestionMovimientos
/*
 * Aquí se controlan las solicitudes, los prestamos y las devoluciones de los libros
 * partiendo por la clase Movimiento
 */
public class GestionMovimientos {

	// Lista vacia para almacenar los prestamos
	LinkedList<Movimiento> prestamo = new LinkedList<Movimiento>();

	// Lista vacia para almacenar las devoluciones
	LinkedList<Movimiento> devolucion = new LinkedList<Movimiento>();

	// Objeto tipo cola para que lleguen las solicitudes una detras de otra y asi mismo atenderlas
	Queue<Movimiento> colaSolicitudes = new LinkedList<>();

	// Objeto tipo pila para que se almacenen las devoluciones de los libros, de la más antigua a la más reciente
	Stack<Movimiento> pilaDevolucion = new Stack<Movimiento>();

	// Método para crear una nueva solicitud, recibiendo como parametros: el usuario logueado, el libro a solicitar
	// y un objeto JPanel para que me salga la ventana de emergencia indicando el exito de la solicitud
	public void crear_solicitud(Usuario usuario, Libro libro, JPanel panel) {

		// Se carga un objeto Movimiento con el usuario logueado y el libro a solicitar
		Movimiento movimiento = new Movimiento(usuario, libro);

		colaSolicitudes.offer(movimiento);

		JOptionPane.showMessageDialog(panel, "Por favor espere 24 horas, si se acepto el prestamo", "Solicitud Creada",
				1);

	}

	public Iterator<Movimiento> traer_solicitudes() {

		return colaSolicitudes.iterator();

	}

	public void aceptar_solicitud(JPanel panel) {

		Movimiento solicitudAceptada = colaSolicitudes.poll();

		if (solicitudAceptada != null) {
			prestamo.add(solicitudAceptada);

			JOptionPane.showMessageDialog(panel, "Se realizó el prestamo correctamente", "Prestamo Exitoso", 1);
		}

	}

	public void cancelar_solicitud(JPanel panel) {

		colaSolicitudes.remove();

		JOptionPane.showMessageDialog(panel, "Se cancelo la solicitud de prestamo", "Solicitud Cancelada", 1);

	}

	public ListIterator<Movimiento> traer_prestamos() {
		
		return prestamo.listIterator();
	}

	public void devolver_libro(JPanel panel, Movimiento movimiento) {

		pilaDevolucion.add(movimiento);
		
		prestamo.remove(movimiento);

		JOptionPane.showMessageDialog(panel, "Se realizó la devolución correctamente", "Devolución Exitosa", 1);

	}

	public ListIterator<Movimiento> traer_devoluciones() {
		return pilaDevolucion.listIterator();
	}

}
